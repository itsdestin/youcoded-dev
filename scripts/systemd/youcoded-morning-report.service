[Unit]
Description=YouCoded morning report (reads check results, writes one summary page, pings the phone)

[Service]
Type=oneshot
# WHY the shared checkout path: the timer must not depend on any one session's worktree.
ExecStart=/usr/bin/node %h/youcoded-dev/scripts/morning-report.mjs --notify
# Read-only job: runs as the user, needs no root, and gets a generous but bounded time.
TimeoutStartSec=15min
Nice=10
