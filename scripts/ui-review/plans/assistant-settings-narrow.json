    { "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes('Assistant settings'))", "settle": 900 },
    { "click": "js:[...document.querySelectorAll('[role=dialog] button')].find(b=>b.textContent.includes('Claude Code'))", "settle": 900 }
   ],
   "expect": "[role=dialog] [aria-label=Back]"
  },
  {
   "name": "narrow-general",
   "actions": [
    { "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes('Assistant settings'))", "settle": 900 },
    { "click": "js:[...document.querySelectorAll('[role=dialog] button')].find(b=>b.textContent.includes('General'))", "settle": 900 }
   ],
