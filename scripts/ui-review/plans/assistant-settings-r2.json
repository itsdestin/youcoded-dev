{
 "base": "http://127.0.0.1:5233/?mode=workbench&child=1&latency=0&scenario=default",
 "width": 1440,
 "height": 900,
 "pre": [
  { "click": "[title=Settings]", "settle": 700 }
 ],
 "shots": [
  {
   "name": "settings-drawer",
   "actions": [],
   "expect": "js:[...document.querySelectorAll('button')].some(b=>b.textContent.includes('Assistant settings'))"
  },
  {
   "name": "assistant-general",
   "actions": [
    { "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes('Assistant settings'))", "settle": 900 }
   ],
   "expect": "js:document.body.textContent.includes('Default model') && document.body.textContent.includes('Tavily')"
  },
  {
   "name": "assistant-cloud",
   "actions": [
    { "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes('Assistant settings'))", "settle": 900 },
    { "click": "js:[...document.querySelectorAll('[role=dialog] nav button')].find(b=>b.textContent.trim()==='Cloud providers')", "settle": 900 }
   ],
   "expect": "js:document.querySelector('[role=dialog] nav button[aria-current=page]')?.textContent.trim()==='Cloud providers' && document.body.textContent.includes('OpenRouter')"
  },
  {
   "name": "assistant-cloud-blocked",
   "url": "http://127.0.0.1:5233/?mode=workbench&child=1&latency=0&scenario=default&chatgpt=blocked",
   "actions": [
    { "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes('Assistant settings'))", "settle": 900 },
    { "click": "js:[...document.querySelectorAll('[role=dialog] nav button')].find(b=>b.textContent.trim()==='Cloud providers')", "settle": 900 }
   ],
   "expect": "[role=dialog] [role=img][aria-label='Cloud providers needs attention']"
  },
  {
   "name": "drawer-attention",
   "url": "http://127.0.0.1:5233/?mode=workbench&child=1&latency=0&scenario=default&chatgpt=blocked",
   "actions": [],
   "expect": "[role=img][aria-label='A provider needs attention']"
  },
  {
   "name": "assistant-local",
   "actions": [
    { "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes('Assistant settings'))", "settle": 900 },
    { "click": "js:[...document.querySelectorAll('[role=dialog] nav button')].find(b=>b.textContent.trim()==='Local models')", "settle": 1200 }
   ],
   "expect": "js:document.querySelector('[role=dialog] nav button[aria-current=page]')?.textContent.trim()==='Local models'"
  },
  {
   "name": "assistant-permissions",
   "actions": [
    { "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes('Assistant settings'))", "settle": 900 },
    { "click": "js:[...document.querySelectorAll('[role=dialog] nav button')].find(b=>b.textContent.trim()==='Permissions')", "settle": 900 }
   ],
   "expect": "[role=dialog] [aria-label='Skip Permissions']"
  },
  {
   "name": "assistant-permissions-skip-on",
   "actions": [
    { "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes('Assistant settings'))", "settle": 900 },
    { "click": "js:[...document.querySelectorAll('[role=dialog] nav button')].find(b=>b.textContent.trim()==='Permissions')", "settle": 900 },
    { "click": "[role=dialog] [aria-label='Skip Permissions']", "settle": 600 }
   ],
   "expect": "js:document.body.textContent.includes('without asking you')"
  },
  {
   "name": "assistant-specialists",
   "actions": [
    { "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes('Assistant settings'))", "settle": 900 },
    { "click": "js:[...document.querySelectorAll('[role=dialog] nav button')].find(b=>b.textContent.trim()==='Specialists')", "settle": 1200 }
   ],
   "expect": "js:document.querySelector('[role=dialog] nav button[aria-current=page]')?.textContent.trim()==='Specialists'"
  },
  {
   "name": "assistant-general-picker",
   "actions": [
    { "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes('Assistant settings'))", "settle": 900 },
    { "click": "js:[...document.querySelectorAll('[role=dialog] button')].find(b=>b.textContent.includes('Sonnet'))", "settle": 900 }
   ],
   "expect": "js:!!document.querySelector('input[placeholder*=\"earch\"]')"
  }
 ]
}
