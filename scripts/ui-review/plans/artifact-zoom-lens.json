    {
     "clickText": "latency-chart.png",
     "settle": 2600
    },
    {
     "click": "[aria-label='Magnify on hover']",
     "settle": 500
    },
    {
     "hover": "js:document.querySelector('[data-zoomable] img')",
     "settle": 700
    }
   ],
   "expect": "js:(() => { const l = document.querySelector('[aria-hidden][style*=\"border-radius: 50%\"]'); return !!l && getComputedStyle(l).visibility === 'visible'; })()"
  },
