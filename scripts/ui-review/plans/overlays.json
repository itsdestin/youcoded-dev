  {
   "name": "local-models-resuming",
   "_why": "`clickText: \"Resume\"` searches the WHOLE page (shot.mjs textExpr), not just the dialog \u2014 with the Model Providers popup gone, this now sits over the resume browser's own session cards, some of which ALSO say exactly 'Resume', and the smallest-element tie can pick the wrong one. Found live-testing this repair (2026-09-24): the shot closed the dialog instead of resuming a download. Scoped to `[role=dialog] button` via eval instead.",
   "actions": [
    {
     "click": "[title=Settings]",
     "settle": 700
    },
    {
     "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes(\"Assistant settings\"))",
     "settle": 900
    },
    {
     "click": "js:[...document.querySelectorAll('[role=dialog] nav button')].find(b=>b.textContent.trim()===\"Local models\")",
     "settle": 1200
    },
    {
     "scrollDialog": "bottom"
    },
    {
     "eval": "[...document.querySelectorAll('[role=dialog] button')].filter(b=>b.textContent.trim()==='Resume').sort((a,b)=>a.querySelectorAll('*').length-b.querySelectorAll('*').length)[0]?.click()",
     "settle": 1200
    }
   ],
   "expect": "js:[...document.querySelectorAll('button')].some(b=>b.textContent.trim()==='Pause') && /DOWNLOADING|Downloading/.test(document.body.textContent)"
  },
