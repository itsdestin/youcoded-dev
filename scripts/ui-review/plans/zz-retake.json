{
 "base": "http://127.0.0.1:5233/?mode=workbench&child=1&latency=0&scenario=default",
 "shots": [
  {
   "name": "settings-backup-sync",
   "actions": [
    {
     "click": "[title=Settings]",
     "settle": 700
    },
    {
     "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes(\"Backup & Sync\"))",
     "settle": 900
    }
   ],
   "expect": "js:document.querySelector('[role=dialog]')||[...document.querySelectorAll('button')].some(b=>b.textContent.trim()==='Retry')"
  },
  {
   "name": "settings-development",
   "actions": [
    {
     "click": "[title=Settings]",
     "settle": 700
    },
    {
     "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes('Development') && b.textContent.includes('Report'))",
     "settle": 900
    }
   ],
   "expect": "[title^='Report a Bug']"
  },
  {
   "name": "settings-keyboard-shortcuts",
   "actions": [
    {
     "click": "[title=Settings]",
     "settle": 700
    },
    {
     "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes(\"Keyboard Shortcuts\"))",
     "settle": 900
    }
   ],
   "measure": [
    "[role=dialog][aria-label='Keyboard Shortcuts']",
    "js:[...document.querySelectorAll('[role=dialog][aria-label=\"Keyboard Shortcuts\"] kbd')].find(k=>k.textContent.includes('Arrow Up/Down'))?.parentElement",
    "js:[...document.querySelectorAll('[role=dialog][aria-label=\"Keyboard Shortcuts\"] kbd')].find(k=>k.textContent.trim()==='Enter')?.parentElement"
   ],
   "expect": "[role=dialog], [aria-label='Close settings'] ~ *"
  },
  {
   "name": "settings-donate",
   "actions": [
    {
     "click": "[title=Settings]",
     "settle": 700
    },
    {
     "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes(\"Donate\"))",
     "settle": 900
    }
   ],
   "expect": "[role=dialog], [aria-label='Close settings'] ~ *"
  }
 ]
}