    },
    {
     "click": "js:[...document.querySelectorAll('button')].find(b=>b.textContent.includes(\"Backup & Sync\"))",
     "settle": 900
    }
   ],
   "expect": "js:document.querySelector('[role=dialog]')||[...document.querySelectorAll('button')].some(b=>b.textContent.trim()==='Retry')"
