    {
     "eval": "(() => { const keep=['chatsearch-find','chatsearch-find-piped']; document.querySelectorAll('section').forEach(sec=>{ let any=false; [...sec.children].forEach(div=>{ const h3=div.querySelector && div.querySelector('h3'); if(!h3) return; if(keep.includes(h3.textContent.trim())){any=true;} else {div.style.display='none';} }); if(!any) sec.style.display='none'; }); window.scrollTo(0,0); })()",
