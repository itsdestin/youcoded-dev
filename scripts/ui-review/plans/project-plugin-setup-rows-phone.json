{
  "_why": "The needs-setup rows on a 390px phone: the instruction must wrap, not be cut off, and Set up here must open its explanation.",
  "base": "http://127.0.0.1:5233/?mode=workbench&child=1&latency=150&scenario=default",
  "width": 390,
  "height": 744,
  "shots": [
    {
      "name": "setup-open-phone",
      "actions": [
        {
          "click": "[aria-label='Open menu']",
          "settle": 500
        },
        {
          "click": "js:[...document.querySelectorAll('button,[role=menuitem]')].find(b=>/^Projects/.test(b.textContent.trim()))",
          "settle": 1000
        },
        {
          "click": "[aria-label='Skills & tools']",
          "settle": 500
        },
        {
          "click": "js:[...document.querySelectorAll('[aria-label=\"Items needing setup on this device\"] button')].filter(b=>b.textContent.trim()==='Set up here')[1]",
          "settle": 300
        }
      ],
      "expect": "js:[...document.querySelectorAll('[role=dialog]')].some(d=>/sign-in stay on the device/.test(d.textContent))"
    }
  ]
}
