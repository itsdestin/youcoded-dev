{
  "base": "http://127.0.0.1:5473/?mode=workbench&child=1&scenario=site&student=1&latency=150&reply=elasticity",
  "theme": "creme",
  "width": 1440,
  "height": 900,
  "zoom": 1.35,
  "fps": 30,
  "boot": 3000,
  "why": "Beat 4. The status-bar chip opens the Model popup; since 2026-09-06 the popup shows the favourites list directly (ModelPicker layout=\"inline\" \u2014 there is no field to click first), so `chip` and `list` both wait for the Claude row and land a few frames apart; Beat4 plays the take as one continuous shot when they do. The Grok row is hovered 400 ms before the pick; `chip2` waits for the status-bar chip's title to start with the Grok id, which is the chip re-rendered on the new binding. The reply fixture is attributed to x-ai/grok-4.",
  "actions": [
    {
      "hold": 900
    },
    {
      "click": "[title$='click to change model'], [data-hint$='click to change model']",
      "settle": 0
    },
    {
      "waitFor": "js:[...document.querySelectorAll('button[aria-pressed]')].find(b=>b.offsetParent!==null&&b.textContent.trim().startsWith('Claude Sonnet 4.6'))",
      "settle": 0,
      "mark": "chip"
    },
    {
      "waitFor": "js:[...document.querySelectorAll('button[aria-pressed]')].find(b=>b.offsetParent!==null&&b.textContent.trim().startsWith('Claude Sonnet 4.6'))",
      "settle": 300,
      "mark": "list"
    },
    {
      "moveTo": "js:[...document.querySelectorAll('button[aria-pressed]')].find(b=>b.offsetParent!==null&&b.textContent.trim().startsWith('Grok 4'))",
      "ms": 400,
      "settle": 400
    },
    {
      "click": "js:[...document.querySelectorAll('button[aria-pressed]')].find(b=>b.offsetParent!==null&&b.textContent.trim().startsWith('Grok 4'))",
      "settle": 300,
      "mark": "pick"
    },
    {
      "waitFor": "[title^='x-ai/grok-4'], [data-hint^='x-ai/grok-4']",
      "settle": 700,
      "mark": "chip2"
    },
    {
      "click": "[placeholder^='Message']",
      "settle": 200
    },
    {
      "typeSlow": "explain elasticity in two lines",
      "cps": 30
    },
    {
      "key": "Enter",
      "settle": 400,
      "mark": "sent"
    },
    {
      "waitForText": "sales barely move",
      "tag": "p",
      "timeout": 25000,
      "settle": 300,
      "mark": "reply"
    },
    {
      "hold": 2500
    }
  ]
}
