{
 "base": "http://127.0.0.1:5473/?mode=workbench&child=1&scenario=default&latency=150",
 "theme": "cotton-candy-sky",
 "width": 1440,
 "height": 900,
 "fps": 30,
 "boot": 3000,
 "actions": [
  {
   "hold": 900
  },
  {
   "click": "[title='All Sessions']",
   "settle": 500,
   "mark": "menu"
  },
  {
   "settle": 400,
   "mark": "resume",
   "click": "js:[...document.querySelectorAll('button')].find(b=>b.offsetParent!==null&&b.textContent.trim()==='Resume'&&!b.title)"
  },
  {
   "waitFor": "[placeholder='Search sessions...']",
   "settle": 1200
  },
  {
   "click": "[placeholder='Search sessions...']",
   "settle": 200
  },
  {
   "typeSlow": "theme",
   "cps": 12,
   "settle": 0,
   "mark": "search"
  },
  {
   "hold": 1200
  },
  {
   "click": "[aria-label^='Organize ']",
   "settle": 600,
   "mark": "organize"
  },
  {
   "click": "js:[...document.querySelectorAll('button[aria-pressed=\"false\"]')].find(b=>b.offsetParent!==null&&b.textContent.trim()==='work')",
   "settle": 500,
   "mark": "tag"
  },
  {
   "click": "textarea[aria-label='Add a note\u2026']",
   "settle": 200
  },
  {
   "typeSlow": "ask about the demand curve",
   "cps": 24,
   "settle": 0,
   "mark": "note"
  },
  {
   "hold": 900
  },
  {
   "key": "Escape",
   "settle": 500
  },
  {
   "click": "[placeholder^='Message']",
   "settle": 0
  },
  {
   "eval": "new Promise(r=>{setTimeout(()=>r(0),8000);const gone=()=>!document.querySelector(\"[placeholder='Search sessions...']\");const done=()=>requestAnimationFrame(()=>requestAnimationFrame(()=>r(1)));if(gone())return done();const o=new MutationObserver(()=>{if(gone()){o.disconnect();done()}});o.observe(document.body,{childList:true,subtree:true})})",
   "settle": 700,
   "mark": "close"
  },
  {
   "moveTo": "[data-session-idx='4']",
   "ms": 500,
   "settle": 300
  },
  {
   "drag": "[data-session-idx='4']",
   "to": "[data-session-idx='1']",
   "ms": 1100,
   "settle": 400,
   "mark": "drag"
  },
  {
   "hold": 1600
  }
 ]
}