+// in-app-shell.ts — a child-process-shaped handle for one command run by in-app-shell-worker.ts (same pattern as
+// tools/in-process-search.ts), so bash.ts and the shell registry treat it like any spawned shell. [PROTOTYPE]
+import { EventEmitter } from 'events';
+import * as os from 'os';
+import * as path from 'path';
+import { PassThrough } from 'stream';
+import { Worker } from 'worker_threads';
+import type { ChildProcess } from 'child_process';
+
+/** `script` is the whole command text (bash.ts's cwd probe included). The shell's environment is built fresh in the worker, so
+ *  `opts.env` (which carries the backend's own process.env) is deliberately ignored. */
+export function spawnInApp(script: string, opts: { cwd?: string | URL }): ChildProcess {
+  const child = new EventEmitter() as EventEmitter & { stdout: PassThrough; stderr: PassThrough; exitCode: number | null; signalCode: string | null; pid?: number; kill(s?: string): boolean };
+  child.stdout = new PassThrough(); child.stderr = new PassThrough(); child.exitCode = null; child.signalCode = null;
+  const home = process.env.HOME || os.homedir();
+  const worker = new Worker(path.join(__dirname, 'in-app-shell-worker.js'), {
+    workerData: { script, cwd: String(opts.cwd ?? home), home, tmp: os.tmpdir(),
+      // Test-only hooks (removable): a token map and permission to reach 127.0.0.1.
+      tokens: JSON.parse(process.env.YOUCODED_SHELL_TEST_TOKENS || '{}'), allowPrivate: process.env.YOUCODED_SHELL_TEST_ALLOW_PRIVATE === '1' },
+  });
+  const finish = (code: number | null, signal: string | null, out = '', err = '') => {
+    if (child.exitCode !== null || child.signalCode !== null) return; // first answer wins
+    child.exitCode = code; child.signalCode = signal;
+    child.stdout.end(out); child.stderr.end(err);
+    child.emit('exit', code, signal);
+    setImmediate(() => child.emit('close', code, signal));
+    void worker.terminate();
+  };
+  worker.once('message', (m: { stdout: string; stderr: string; exitCode: number }) => finish(m.exitCode, null, m.stdout, m.stderr));
+  worker.once('error', (e) => { child.emit('error', e); finish(1, null); });
+  worker.once('exit', () => finish(1, null, '', 'the command stopped unexpectedly (the shell ran out of memory?)\n'));
+  // Stop / time limit / KillShell. No signal story here: the thread is simply ended.
+  child.kill = (signal) => { finish(null, signal ?? 'SIGTERM'); return true; };
+  return child as unknown as ChildProcess;
+}
