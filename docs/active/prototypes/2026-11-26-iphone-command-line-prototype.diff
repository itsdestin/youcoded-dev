+// in-app-shell-worker.ts — one shell command, run on a phone that cannot start programs. A worker thread per command,
+// so Stop / the time limit / KillShell is simply `worker.terminate()`. [PROTOTYPE, design v2 §2-§8]
+//
+// WHY (iPhone app, card #89): iOS forbids starting any program, so the Bash tool runs just-bash (a shell written in
+// JavaScript, ~80 commands) with just-git as its `git`. Everything it can reach is the app's own Documents + tmp
+// folders; nothing else on the phone and none of the backend's secrets (userData, process.env) are visible.
+import { parentPort, workerData } from 'worker_threads';
+import fs from 'fs';
+import { lookup } from 'dns/promises';
+import { Bash, InMemoryFs, MountableFs, ReadWriteFs, defineCommand, type SecureFetch } from 'just-bash';
+import { createGit } from 'just-git';
+import { iosFetch } from '../headless/ios-fetch';
+import { assertPublicHttpUrl } from './tools/net-guard';
+
+interface Job { script: string; cwd: string; home: string; tmp: string; tokens: Record<string, string>; allowPrivate: boolean }
+const job = workerData as Job;
+
+// --- filesystem. WHY both spellings: iOS reaches Documents through /var -> /private/var; the other tools use whichever
+// spelling the OS handed out, and just-bash refuses a path that crosses a symlink, so each folder is mounted at its
+// logical path AND its realpath (same files, either spelling works).
+const base = new InMemoryFs();
+const mfs = new MountableFs({ base });
+const mounted: string[] = [];
+for (const dir of [job.home, job.tmp]) {
+  for (const at of new Set([dir, fs.realpathSync(dir)])) {
+    if (mounted.some((m) => at === m || at.startsWith(m + '/'))) continue; // tmp inside HOME is already covered
+    // allowSymlinks: a link inside a mount works (git repos need it); one pointing OUT of the mount is refused.
+    mfs.mount(at, new ReadWriteFs({ root: fs.realpathSync(dir), allowSymlinks: true, maxFileReadSize: 64 * 1024 * 1024 }));
+    mounted.push(at);
+  }
+}
+
+// --- honest absences: programs that cannot exist here answer with what to do instead (exit 127 = "not found").
+const NA = 'not available on this iPhone';
+const STUBS: Array<[string, string]> = [
+  ['python python3 pip pip3', `${NA} (no Python). For data use jq/awk/sort/cut; anything bigger: write the file and say so.`],
+  ['node npm npx yarn pnpm deno bun', `${NA} (no Node). Use jq/awk for data work; for a web page just write the .html file.`],
+  ['sudo apt apt-get brew yum dnf pacman snap', 'cannot install programs on this iPhone. Only the built-in commands exist (run `help`).'],
+  ['make gcc cc clang cargo go ruby perl php java ffmpeg convert magick pandoc ssh scp rsync docker gh open vim nano vi less', `${NA}.`],
+];
+const stubNames = new Set(STUBS.flatMap(([n]) => n.split(' ')));
+const stubs = STUBS.flatMap(([names, msg]) => names.split(' ').map((n) =>
+  defineCommand(n, async () => ({ stdout: '', stderr: `${n}: ${msg}\n`, exitCode: 127 }))));
+// A real `which` that agrees with the stubs (a stub is "not found").
+const which = defineCommand('which', async (args, c) => {
+  let out = ''; let rc = 0;
+  for (const n of args.filter((a) => !a.startsWith('-'))) {
+    const r = stubNames.has(n) ? { exitCode: 1, stdout: '' } : await c.exec!(`command -v ${JSON.stringify(n)}`, { cwd: c.cwd });
+    if (r.exitCode === 0) out += r.stdout; else rc = 1;
+  }
+  return { stdout: out, stderr: '', exitCode: rc };
+});
+
+// --- network. ONE fetch for curl and git: iosFetch (the app's own, no WebAssembly) with redirects followed by hand so every
+// hop is checked to be a PUBLIC address (no 127.0.0.1 = the backend itself, no home network). WHY not just-bash's own
+// denyPrivateRanges: it needs the `undici` library, which the iPhone bundle replaces with a stub (ios-undici.ts).
+async function safeFetch(input: string | URL | Request, init: RequestInit = {}): Promise<Response> {
+  let method = (init.method ?? 'GET').toUpperCase(); let body = init.body; const headers = new Headers(init.headers);
+  for (let hop = 0, cur = String(input); ; hop++) {
+    if (!job.allowPrivate) await assertPublicHttpUrl(cur, undefined, init.signal ?? undefined);
+    const res = await iosFetch(cur, { ...init, method, body, headers, redirect: 'manual' });
+    const loc = res.headers.get('location');
+    if (res.status < 300 || res.status >= 400 || !loc || init.redirect === 'manual') return res;
+    if (hop >= 20) throw new TypeError('too many redirects');
+    const next = new URL(loc, cur);
+    if (next.origin !== new URL(cur).origin) headers.delete('authorization');
+    if (res.status === 303 || ((res.status === 301 || res.status === 302) && method === 'POST')) { method = 'GET'; body = undefined; }
+    cur = next.href;
+  }
+}
+// just-bash's curl wants its own result shape.
+const curlFetch: SecureFetch = async (url, o = {}) => {
+  const res = await safeFetch(url, { method: o.method, headers: o.headers as HeadersInit, body: o.body, redirect: o.followRedirects === false ? 'manual' : 'follow',
+    signal: AbortSignal.timeout(o.timeoutMs ?? 120_000) });
+  return { status: res.status, statusText: res.statusText, headers: Object.fromEntries(res.headers), body: new Uint8Array(await res.arrayBuffer()), url: res.url || String(url) };
+};
+
+// --- git. WHY the guard: just-git mis-reads an index that is not version 2 or is a split index (a silent bad commit was
+// reproduced), so such a repository is refused with a sentence instead.
+const git = createGit({
+  identity: { name: 'YouCoded', email: 'you@youcoded.local' },
+  // The token comes from workerData (never the shell's environment): host -> token.
+  credentials: (url) => { const t = job.tokens[new URL(url).hostname]; return t ? { type: 'basic', username: 'x-access-token', password: t } : null; },
+  network: { fetch: safeFetch },
+});
+const guardedGit = defineCommand('git', async (args, c) => {
+  let start = c.cwd; // `git -C <dir>` works somewhere else: the guard must look there (found in testing: it was bypassed)
+  for (let i = 0; args[i] === '-C'; i += 2) start = c.fs.resolvePath(start, args[i + 1] ?? '.');
+  for (let dir = start; ; dir = dir.slice(0, dir.lastIndexOf('/')) || '/') {
+    const gitDir = `${dir === '/' ? '' : dir}/.git`;
+    if (await c.fs.exists(`${gitDir}/index`)) {
+      const head = Buffer.from(await c.fs.readFileBuffer(`${gitDir}/index`)).subarray(0, 8);
+      const split = (await c.fs.readdir(gitDir)).some((n) => n.startsWith('sharedindex.'));
+      if (head.readUInt32BE(4) !== 2 || split) {
+        return { stdout: '', stderr: 'git: this repository was made by a newer git than the one built in here (index version or split index); it cannot be used safely on this iPhone.\n', exitCode: 1 };
+      }
+      break;
+    }
+    if (dir === '/') break;
+  }
+  return git.execute(args, c);
+});
+
+const bash = new Bash({
+  fs: mfs,
+  cwd: mounted.some((m) => job.cwd === m || job.cwd.startsWith(m + '/')) ? job.cwd : job.home,
+  // Fresh environment: the backend's own process.env (keys, tokens) never reaches a command.
+  env: { HOME: job.home, USER: 'mobile', SHELL: '/bin/bash', TMPDIR: job.tmp, PATH: '/usr/bin:/bin', NO_COLOR: '1', LANG: 'C.UTF-8' },
+  // defenseInDepth crashes on Node 18; it guards just-bash's optional JS/Python runtimes, which are never enabled here.
+  defenseInDepth: false,
+  fetch: curlFetch,
+  customCommands: [guardedGit, which, ...stubs],
+});
+
+bash.exec(job.script).then(
+  (r) => parentPort!.postMessage({ stdout: r.stdout, stderr: r.stderr, exitCode: r.exitCode }),
+  (e) => parentPort!.postMessage({ stdout: '', stderr: `shell failed: ${e?.message ?? e}\n`, exitCode: 1 }),
+);
