    {
      "id": "R-ALL",
      "words": true,
      "surface": "Every Settings menu",
      "path": "Design guide",
      "headline": "Which card look should every Settings menu use?",
      "today": "Settings uses 8 different card looks, some see-through, with different spacing and text sizes.",
      "problem": "Menus look like they were each styled separately and feel cluttered.",
      "proposal": "One shared solid card for every group, the same spacing and text styles everywhere; groups stay where they are.",
      "options": [
        {
          "id": "dark",
          "label": "Solid dark card",
          "pros": [
            "Matches the Backup & Sync card you liked.",
            "Calm and uniform."
          ],
          "cons": [
            "On Midnight the card is the same colour as the background; only its border shows it."
          ]
        },
        {
          "id": "light",
          "label": "Solid light card",
          "pros": [
            "Stands out from the background on every theme."
          ],
          "cons": [
            "Brighter; slightly heavier on light themes."
          ],
          "recommended": true
        },
        {
          "id": "neither",
          "label": "Neither",
          "pros": [
            "Nothing changes."
          ],
          "cons": [
